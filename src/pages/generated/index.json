  "description": "A B KHAN & ASSOCIATES - Chartered Accountancy firm offering Accounting, Taxation, Audit, GST, Business Registration and Corporate Compliance services in Navi Mumbai.",
  "html": "<!-- HERO -->\n<section class=\"hero home-hero-light\">\n  <div class=\"container\">\n    <div class=\"hero-left\">\n      <h1>Your Trusted <span class=\"home-accent\">Chartered Accountant</span> for Business Growth</h1>\n      <div class=\"home-gold-divider\"></div>\n      <p class=\"lead\">We provide comprehensive solutions for Accounting, Taxation, Audit, GST, Business Registration and Corporate Compliance.</p>\n      <div class=\"hero-actions\">\n        <a href=\"#contact\" class=\"btn btn-gold\">📅 Book Consultation</a>\n        <a href=\"#services\" class=\"btn btn-outline-navy\">🧭 Explore Services</a>\n        <a href=\"https://wa.me/918286681960\" class=\"btn btn-outline-green\">💬 WhatsApp Us</a>\n</div>\n    </div>\n    <div class=\"hero-right\">\n      <div class=\"home-hero-image-wrap\">\n        <img src=\"https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=900&q=80\" alt=\"Accounting dashboard and financial analysis on a laptop\">\n      </div>\n    </div>\n  </div>\n</section>\n\n<div class=\"home-quick-services-wrap\">\n  <div class=\"container\">\n    <div class=\"quick-services\">\n      <a href=\"/services/audit\" class=\"qs-item\"><div class=\"qs-icon\">📋</div><span>Statutory Audit</span></a>\n      <a href=\"/services/audit\" class=\"qs-item\"><div class=\"qs-icon\">🏦</div><span>Bank Audit</span></a>\n      <a href=\"/services/income-tax\" class=\"qs-item\"><div class=\"qs-icon\">🧾</div><span>Income Tax</span></a>\n      <a href=\"/services/gst\" class=\"qs-item\"><div class=\"qs-icon\">🧮</div><span>GST Services</span></a>\n      <a href=\"/services/accounting\" class=\"qs-item\"><div class=\"qs-icon\">📊</div><span>Accounting</span></a>\n      <a href=\"/services/roc-compliance\" class=\"qs-item\"><div class=\"qs-icon\">🏢</div><span>ROC Compliance</span></a>\n      <a href=\"/services/business-consultancy\" class=\"qs-item\"><div class=\"qs-icon\">🤝</div><span>Business Advisory</span></a>\n    </div>\n  </div>\n</div>\n\n<!-- ABOUT -->\n<section class=\"section about-section\" id=\"about\">\n  <div class=\"container about-grid\">\n    <div class=\"about-img-wrap\">\n      <img src=\"https://images.unsplash.com/photo-1554224154-26032ffc0d07?w=700&q=80\" alt=\"Income tax and GST documentation and compliance paperwork\">\n    </div>\n    <div>\n      <p class=\"eyebrow\">About Our Firm</p>\n      <h2 style=\"font-size:32px;margin-bottom:16px;\">Delivering Excellence, Building Trust</h2>\n      <p style=\"color:var(--text-muted);margin-bottom:10px;\">A B KHAN & ASSOCIATES is a premier Chartered Accountancy firm providing comprehensive financial and compliance solutions to businesses, startups, professionals and individuals across Accounting, Taxation, Audit, GST, Company Registration, ROC Compliance, Payroll, Financial Advisory and Business Consultancy.</p>\n      <p style=\"color:var(--text-muted);\">We are committed to integrity, professionalism, transparency, accuracy, timely compliance and complete client satisfaction.</p>\n      <div class=\"trust-grid\">\n        <div class=\"trust-item\"><div class=\"ti-icon\">🛡️</div><span>Integrity & Transparency</span></div>\n        <div class=\"trust-item\"><div class=\"ti-icon\">🎯</div><span>Accurate Solutions</span></div>\n        <div class=\"trust-item\"><div class=\"ti-icon\">⏱️</div><span>Timely Compliance</span></div>\n        <div class=\"trust-item\"><div class=\"ti-icon\">🤝</div><span>Client-Focused Approach</span></div>\n      </div>\n      <a href=\"/about\" class=\"btn btn-navy\">Discover Our Firm →</a>\n    </div>\n  </div>\n</section>\n\n<!-- CORE SERVICES -->\n<section class=\"section\" id=\"services\" style=\"background:var(--off-white)\">\n  <div class=\"container\">\n    <div class=\"section-head center\">\n      <p class=\"eyebrow\" style=\"justify-content:center\">Our Professional Services</p>\n      <h2 class=\"home-flanked-heading\"><span class=\"home-flank-line\"></span>Complete Financial &amp; Compliance Solutions<span class=\"home-flank-line\"></span></h2>\n    </div>\n    <div class=\"services-grid\">\n      <div class=\"service-card\"><div class=\"service-icon home-icon-circle\">📚</div><h3>Accounting & Outsourcing</h3><p>Bookkeeping, Accounting Outsourcing, Virtual Accounting & MIS.</p><a href=\"/services/accounting\">Learn More →</a></div>\n      <div class=\"service-card\"><div class=\"service-icon home-icon-circle\">🔍</div><h3>Audit & Assurance</h3><p>Statutory Audit, Internal Audit, Tax Audit, Stock Audit & more.</p><a href=\"/services/audit\">Learn More →</a></div>\n      <div class=\"service-card\"><div class=\"service-icon home-icon-circle\">🧾</div><h3>Income Tax Services</h3><p>ITR Filing, Tax Planning, Tax Advisory, Notices & Appeal Support.</p><a href=\"/services/income-tax\">Learn More →</a></div>\n      <div class=\"service-card\"><div class=\"service-icon home-icon-circle\">🧮</div><h3>GST Services</h3><p>GST Registration, Returns, GST Audit, Notices, Refunds & Advisory.</p><a href=\"/services/gst\">Learn More →</a></div>\n      <div class=\"service-card\"><div class=\"service-icon home-icon-circle\">🏢</div><h3>ROC & Corporate Compliance</h3><p>Company Incorporation, Annual Filing, ROC, LLP Compliance & more.</p><a href=\"/services/roc-compliance\">Learn More →</a></div>\n      <div class=\"service-card\"><div class=\"service-icon home-icon-circle\">💼</div><h3>Payroll Management</h3><p>Salary Processing, PF, ESIC, Professional Tax & Payroll Outsourcing.</p><a href=\"/services/payroll\">Learn More →</a></div>\n      <div class=\"service-card\"><div class=\"service-icon home-icon-circle\">📈</div><h3>Virtual CFO Services</h3><p>Virtual CFO, Financial Analysis, Budgeting & Forecasting.</p><a href=\"/services/virtual-cfo\">Learn More →</a></div>\n      <div class=\"service-card\"><div class=\"service-icon home-icon-circle\">🎯</div><h3>Business Consultancy</h3><p>Strategic Planning, Process Optimization, Business Growth.</p><a href=\"/services/business-consultancy\">Learn More →</a></div>\n    </div>\n  </div>\n</section>\n\n<!-- WHY CHOOSE US -->\n<section class=\"section why-choose\">\n  <div class=\"container\">\n    <div class=\"section-head center\">\n      <p class=\"eyebrow\" style=\"justify-content:center\">Why Choose Us</p>\n      <h2>Reasons Businesses Trust A B KHAN & ASSOCIATES</h2>\n    </div>\n    <div class=\"why-grid why-grid-4\">\n      <div class=\"why-item\" data-count=\"500\" data-suffix=\"+\"><strong><span class=\"counter\">500</span>+</strong><span>Happy Clients</span></div>\n      <div class=\"why-item\"><strong>100%</strong><span>Commitment</span></div>\n      <div class=\"why-item\"><strong>Timely</strong><span>Compliance</span></div>\n      <div class=\"why-item\"><strong>Secure</strong><span>Data Protection</span></div>\n    </div>\n  </div>\n</section>\n\n\n<!-- GLOBAL ASSOCIATE NETWORK -->\n<section class=\"section global-network\" id=\"global-network\">\n  <div class=\"container\">\n    <div class=\"global-network-top\">\n      <div class=\"global-network-copy\">\n        <p class=\"global-network-eyebrow\">International Reach</p>\n        <h2 class=\"global-network-title\">GLOBAL ASSOCIATES <span>NETWORK</span></h2>\n        <p class=\"partners-network-text\">Supported by a trusted network of associate partners across <strong>India</strong> and key international jurisdictions including the <strong>UAE, Saudi Arabia &amp; Kuwait</strong>.</p>\n        <div class=\"global-network-points\">\n          <div class=\"gn-point\"><span class=\"gn-icon\">🤝</span><span>Trusted Relationships</span></div>\n          <div class=\"gn-point\"><span class=\"gn-icon\">🛡️</span><span>Global Compliance</span></div>\n          <div class=\"gn-point\"><span class=\"gn-icon\">🌐</span><span>Cross-Border Expertise</span></div>\n          <div class=\"gn-point\"><span class=\"gn-icon\">📈</span><span>Business Growth</span></div>\n        </div>\n      </div>\n    </div>\n    <div class=\"global-associates-grid\">\n      <article c